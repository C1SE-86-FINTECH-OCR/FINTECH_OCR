+def _spatial_money(cell: str) -> float | None:
+    """Read a whole table cell, rejecting formulas and OCR-split digit groups."""
+    value = " ".join((cell or "").split()).strip()
+    if re.fullmatch(r"(?:\d{1,3}(?:[.,]\d{3})+|\d{4,}|0)(?:[.,]\d{1,2})?", value):
+        return money(value)
+    return None
+
