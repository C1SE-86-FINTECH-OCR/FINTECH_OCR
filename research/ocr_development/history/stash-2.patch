+def party_name_anchor(read, line, lines, boundary):
+    """Return the actual role-heading line used to own a generic name."""
+    h = median(read.boxes[i].word[3] - read.boxes[i].word[1] for i in line.ids)
+    left = min(read.boxes[i].word[0] for i in line.ids)
+    anchors = []
+    for other in lines:
+        if other is line or not other.y < line.y < boundary:
+            continue
+        label = party_label(other.text)
+        if not label or label[0] not in ('seller_name', 'buyer_name') or label[2]:
+            continue
+        x = min(read.boxes[i].word[0] for i in other.ids)
+        if abs(left - x) > 3 * h:
+            continue
+        # Do not carry a heading across another unlabeled party block.
+        if any(other.y < peer.y < line.y
+               and (p := party_label(peer.text)) and p[0] == 'party_name'
+               and abs(min(read.boxes[i].word[0] for i in peer.ids) - left) <= 2 * h
+               for peer in lines):
+            continue
+        anchors.append((other, label[1]))
+    if not anchors:
+        return None
+    latest = max(anchor.y for anchor, _role in anchors)
+    roles = {role for anchor, role in anchors if latest - anchor.y < h / 2}
+    if len(roles) != 1:
+        return None
+    return max(anchors, key=lambda entry: entry[0].y)[0]
+
