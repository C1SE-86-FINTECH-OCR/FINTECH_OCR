+def contextual_party_label(read, line, lines, boundary):
+    """Bind an unqualified name label to its observed section and column."""
+    spec = party_label(line.text)
+    if not spec or spec[0] != 'party_name':
+        return spec
+    anchor = party_name_anchor(read, line, lines, boundary)
+    if anchor is None:
+        return None
+    role = party_label(anchor.text)[1]
+    return role + '_name', role, spec[2]
+
