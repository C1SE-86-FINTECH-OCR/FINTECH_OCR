+def _fintech_ai_env(name: str, default: str = '') -> str:
+    """Read only explicit AI settings; environment overrides backend/.env.
+
+    Existing Gemini settings stay inside the project's Settings object.
+    Never log secrets or write to .env.
+    """
+    val = os.environ.get(name)
+    if val is not None:
+        return val.strip().strip('\"\'')
+    env_files = (Path(__file__).resolve().parents[1] / '.env.ollama',
+                 Path(__file__).resolve().parents[1] / '.env')
+    for env_file in env_files:
+        if not env_file.is_file():
+            continue
+        for line in env_file.read_text(encoding='utf-8-sig').splitlines():
+            line = line.strip()
+            if line.startswith(name + '='):
+                return line.partition('=')[2].strip().strip('\"\'')
+    return default
+
