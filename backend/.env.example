# Development: works immediately without Docker
DATABASE_URL=sqlite:///./fintech_ocr.db
# Production-like PostgreSQL (start docker compose from project root):
# DATABASE_URL=postgresql+psycopg://fintech:fintech_dev@localhost:5432/fintech_ocr
JWT_SECRET=dev-only-replace-this-with-random-long-secret-32-characters
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8081
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=20
ACCESS_TOKEN_MINUTES=480
APP_ENV=development

# Local preview ONLY; disabled by default. Never grants G13/NFR01 acceptance.
# Use tools/serve_local_preview.py --enable-preview to bind only 127.0.0.1
# with the existing fintech_ocr_rbac_test database and uploads_rbac_test.
# Normal OCR_PIPELINE stays current; the preview selector is separate.
OCR_LOCAL_PREVIEW_ENABLED=false
OCR_LOCAL_PREVIEW_PIPELINE=current
OCR_LOCAL_PREVIEW_HOST=127.0.0.1

# Gemini Free-only: TEMPLATE ONLY. Do not overwrite your real .env with this file.
# All permissions stay false until the project/model and data approvals exist.
# Never put the key in web/.env, VITE_* variables, Git or approval manifests.
GEMINI_ENABLED=false
GEMINI_ALLOW_EXTERNAL_TRANSFER=false
GEMINI_API_KEY=
# Configurable; the current policy accepts these text models only:
# gemini-3.8-flash, gemini-3.5-flash-lite, gemini-3.1-flash-lite.
# A listed model is NOT proof of access/quota for your Free project.
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FREE_TIER_CONFIRMED=false
GEMINI_BILLING_DISABLED_CONFIRMED=false
# Real reference covering the correct project's Free status, billing off,
# and access/quota for the selected model. Never invent an approval reference.
GEMINI_FREE_TIER_REFERENCE=
GEMINI_DATA_PROCESSING_APPROVED=false
# Real approval of permitted non-sensitive data transfer to Google Free Tier.
GEMINI_APPROVAL_REFERENCE=
# JSON outside Git recommended; relative paths resolve from backend/.
# Example outside Git, relative to backend/: ../../Gemini_FreeTier/approved_documents.json
# Safe empty manifest: {"documents": []}. It authorizes NO documents.
# Each approved entry must contain exactly: sha256, data_class,
# non_sensitive_confirmed, external_transfer_approved, approval_reference.
# Unlisted documents remain local OCR/Hybrid, even when Gemini is enabled.
GEMINI_FREE_TIER_MANIFEST=
# One-time administrator policy. Uploaders only select/upload files.
# approved_scope: one outside-Git rights-based administrator record specifies
# uploader IDs and file types. Scope membership follows the administrator's
# actual delegation; it is not an automated finding of document ownership.
# No source directory, per-upload consent or manual hash list is required.
# Sharing authority and Free Tier terms acceptance are separate from sensitivity.
# Unknown sensitivity must be recorded as not_assessed, never non_sensitive.
# Global GEMINI_ENABLED/ALLOW_EXTERNAL_TRANSFER/Free/data approvals still apply.
GEMINI_AUTO_POLICY_ENABLED=false
# Default preserves existing deployments; choose approved_scope after approval.
GEMINI_AUTO_POLICY_MODE=manifest
GEMINI_AUTO_POLICY_PATH=
# Example relative to backend/: ../../Gemini_FreeTier/approved_upload_scope.json
# Rights-based JSON keys: enabled, scope_id, scope_basis, description, user_ids,
# file_types, data_class, sharing_authority_confirmed, free_tier_terms_accepted,
# sensitivity, external_transfer_approved, approval_reference.
# scope_basis=administrator_authorized_uploads; data_class=authorized_invoice;
# sensitivity=not_assessed/sensitive/non_sensitive (operator assessment only).
# user_ids=[positive numeric IDs]; file_types subset of pdf,jpg,png,xml;
# Backend binds each decision to the actual uploaded bytes and rechecks the
# policy before sending. No wildcard or inferred third-party data rights.
# Optional stricter mode: scope_basis=authorized_source_documents and add
# authorized_source_roots=[administrator-designated local directories].
# Legacy whole-account non_sensitive_confirmed records remain compatible;
# the rights-based mode does not require that assertion.
# Legacy manifest mode only: authorized IDs AND an exact approved file hash.
GEMINI_AUTO_POLICY_USER_IDS=
# Audit decisions are generated automatically outside Git; no user consent is
# fabricated. The document approval reference comes from the approved manifest.
# GEMINI_POLICY_AUDIT_DIR=../../Gemini_FreeTier/policy_decisions
# Technical output cap, not a confidence threshold; valid range 256..32768.
GEMINI_MAX_OUTPUT_TOKENS=8192
# Single outbound attempt; 429 blocks subsequent calls for this interval or
# Retry-After, whichever is longer. Concurrent calls fall back locally.
GEMINI_RATE_LIMIT_COOLDOWN_SECONDS=60
# Legacy paid configuration: keep false. True is rejected by Free-only policy.
GEMINI_PAID_TIER_CONFIRMED=false
# Unused in Free-only mode; no Paid Tier proof is required.
GEMINI_PAID_TIER_REFERENCE=
# Approval and manifest formats are documented above; all sharing is disabled by default.
# Existing APP_ENV/OCR_PIPELINE/database/upload settings are independent.
# Do not select hybrid_v8_final to bypass testing restrictions or Gate G13.

# Search has separate model/project entitlement. Keep disabled until verified free.
GEMINI_SEARCH_GROUNDING_ENABLED=false
GEMINI_SEARCH_FREE_TIER_CONFIRMED=false

# Invoice OCR Gemini is separately opt-in; tax chat never sends original images.
OCR_INVOICE_GEMINI_ENABLED=false
# Optional business-registry supplement: provision approved project credentials.
CASSO_APP_ID=
CASSO_APP_SECRET=
# Optional relative JSON risk-policy path; leave empty for the existing local rules.
INVOICE_RISK_POLICY_PATH=
